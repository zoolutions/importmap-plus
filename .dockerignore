# Trims the REPO-ROOT build context for the docs site image.
#
# The docs site (docs/) depends on this gem through `gem "importmap-plus",
# path: ".."`, so docs/Dockerfile is built from the repo root: the gem at
# /app, the app at /app/docs. Everything the image doesn't need stays out of
# the context. The gemspec lists its files with Dir[], not `git ls-files`, so
# .git can go too.

/.git/
/.gitignore
/.gitattributes

# Editor + AI-assistant configs.
/.claude/
/.cursor/
/.vscode/
/.idea/
/.ruby-lsp/
/.devcontainer/
/codedb.snapshot

# Gem-level dev/test artifacts — not part of the docs app image. The gemspec
# packages app/, lib/ and a few root files; it never ships test/ or gemfiles/.
/test/
/gemfiles/
/bin/
/tmp/
/pkg/
/*.gem
/Gemfile
/Gemfile.lock
/Appraisals
/Rakefile

# CI meta.
/.github/

# Bundler config (the Dockerfile's BUNDLE_* env drives the install).
/.bundle
/docs/.bundle

# Environment files and credentials — never bake secrets into an image.
/.env*
/docs/.env*
/docs/config/master.key
/docs/config/credentials/*.key

# --- The docs app (docs/) --------------------------------------------------
# JS deps + generated assets: `bun install` + `assets:precompile` rebuild these
# inside the build stage.
/docs/node_modules/
/docs/app/assets/builds/*
!/docs/app/assets/builds/.keep
# Generated by bin/build-css — Tailwind resolves the gem @source globs at build.
/docs/app/assets/stylesheets/tailwind.sources.css
/docs/public/assets

# Logs and tempfiles (keep the dirs, drop the contents).
/docs/log/*
!/docs/log/.keep
/docs/tmp/*
!/docs/tmp/.keep
/docs/tmp/pids/*
!/docs/tmp/pids/.keep

# The docs app's own tests + deploy meta.
/docs/spec/
/docs/.rspec
/docs/coverage/
/docs/.dash/
