# Ignore the default SQLite database.
/test/dummy/db/*.sqlite3
/test/dummy/db/*.sqlite3-*

# Ignore all logfiles and tempfiles.
/test/dummy/log/*
/test/dummy/tmp/*
!/test/dummy/log/.keep
!/test/dummy/tmp/.keep

# Ignore pidfiles, but keep the directory.
/test/dummy/tmp/pids/*
!/test/dummy/tmp/pids/
!/test/dummy/tmp/pids/.keep

# Ignore uploaded files in development.
/test/dummy/storage/*
!/test/dummy/storage/.keep

/test/dummy/public/assets
.byebug_history
*.gem

# Ignore Gemfile.lock files for Rails main branch.
/gemfiles/*.lock

# Worktrees left by the retired local /finish-prs and by parallel agents (the plugin's /lode:finish-prs uses mktemp)
/.claude/worktrees/

# lode/tmp is session scratch (gate output, handovers); never memory
/lode/tmp/
