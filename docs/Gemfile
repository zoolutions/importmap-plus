source "https://rubygems.org"

# docs-kit shared docs chrome + its runtime deps
# docs-kit shared docs chrome + its runtime deps. Pinned to a released version so
# a docs-kit change can't silently reshape this site on the next bundle.
gem "docs-kit", "~> 1.1", ">= 1.1.1", require: "docs_kit"
gem "daisyui", require: "daisy_ui"
gem "phlex-rails"
gem "rails_icons", "~> 1.1"
gem "rouge"

# docs-kit's optional read-only MCP server (POST /mcp, JSON-RPC). Present so the
# endpoint goes live (routes drawn in config/routes.rb); the zoolutions docs
# fleet is consumed by agents. Pinned (pre-1.0) so a routine bundle update can't
# pull a breaking release into this public endpoint.
gem "mcp", "~> 0.22.0"

# Throttle the public, unauthenticated AI endpoints (/mcp, /llms*, /docs/search)
# by IP — they are bare ActionController::Base controllers in the gem, so a
# controller-level rate_limit can't reach them; a Rack middleware can. See
# config/initializers/rack_attack.rb.
gem "rack-attack"

# json 3.0 dropped the positional options argument that Rails 8.1's JSON
# parameter parser still passes, which breaks every POST /mcp with a parse
# error. Hold the 2.x line until Rails catches up.
gem "json", "~> 2.21"

# Optional: expose these docs to AI agents over MCP (a read-only /mcp endpoint).
# Uncomment this and the /mcp route in config/routes.rb. See the docs-kit README.
# gem "mcp"

# Bundle edge Rails instead: gem "rails", github: "rails/rails", branch: "main"
gem "rails", "~> 8.1.3", ">= 8.1.3.1"
# The modern asset pipeline for Rails [https://github.com/rails/propshaft]
gem "propshaft"
# Use the Puma web server [https://github.com/puma/puma]
gem "puma", ">= 5.0"
# The gem this site documents, dogfooded: it IS the import map gem for this app,
# and it supplies Importmap::VERSION for the sidebar badge. A path dep on the
# repo root (the app lives at docs/), so the Docker build context is the repo
# root too (see config/deploy.yml `context: ..`).
gem "importmap-plus", path: ".."
# Hotwire's SPA-like page accelerator [https://turbo.hotwired.dev]
gem "turbo-rails"
# Hotwire's modest JavaScript framework [https://stimulus.hotwired.dev]
gem "stimulus-rails"

# Use Active Model has_secure_password [https://guides.rubyonrails.org/active_model_basics.html#securepassword]
# gem "bcrypt", "~> 3.1.7"

# Windows does not include zoneinfo files, so bundle the tzinfo-data gem
gem "tzinfo-data", platforms: %i[ windows jruby ]

# Add HTTP asset caching/compression and X-Sendfile acceleration to Puma [https://github.com/basecamp/thruster/]
gem "thruster", require: false

group :development, :test do
  # See https://guides.rubyonrails.org/debugging_rails_applications.html#debugging-with-the-debug-gem
  gem "debug", platforms: %i[ mri windows ], require: "debug/prelude"

  # Audits gems for known security defects (use config/bundler-audit.yml to ignore issues)
  gem "bundler-audit", require: false

  # Static analysis for security vulnerabilities [https://brakemanscanner.org/]
  gem "brakeman", require: false

  # Omakase Ruby styling [https://github.com/rails/rubocop-rails-omakase/]
gem "rubocop-rails-omakase", require: false
# The site's own .rubocop.yml inherits docs-kit's shipped cops; rubocop-rspec
# covers the request specs.
gem "rubocop", require: false
gem "rubocop-rspec", require: false

# The site's test suite: render every registered page, exercise the AI
# surfaces (/llms.txt, /docs/search, /mcp).
gem "rspec-rails"
end

group :development do
  # Use console on exceptions pages [https://github.com/rails/web-console]
  gem "web-console"
end
